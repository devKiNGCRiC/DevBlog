# ============================================================
# .env.example — This is a TEMPLATE for your .env file.
# This file IS pushed to GitHub so others know what keys to fill.
# But the ACTUAL .env file with real values is NEVER pushed.
#
# HOW TO USE:
# 1. Copy this file and rename the copy to ".env"
# 2. Fill in all the real values
# ============================================================

# --- MongoDB Connection ---
# Go to MongoDB Atlas > Connect > Drivers > Copy the connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/<dbname>

# --- JWT (JSON Web Token) Secret ---
# This is like a secret password used to sign tokens.
# Make it long and random. You can type anything — no one will see it.
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=7d

# --- Cloudinary Credentials ---
# Go to cloudinary.com > Login > Dashboard > Copy these 3 values
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Server Port & CORS ---
# Which port number the backend server will run on your computer
PORT=5000
NODE_ENV=development

# Your React dev server URL (used by CORS to allow requests from the frontend)
CLIENT_URL=http://localhost:5173

# --- Email (Nodemailer) ---
# Used for sending email verification and password reset emails.
# For Gmail: use an App Password (not your regular password).
# See: https://support.google.com/accounts/answer/185833
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here
EMAIL_FROM="DevBlog <your_email@gmail.com>"

# --- AI writing assistant (optional) ---
# Enables "AI suggestions" (excerpt, tags, titles) in the post editor, powered by Claude.
# Leave empty to turn the feature off. Get a key from: https://console.anthropic.com
# Each suggestion is a paid API call (rate limited to 20 per user per hour).
ANTHROPIC_API_KEY=
