# ============================================================
# .gitignore — Root-level Git ignore rules
#
# This file tells Git: "Don't track these files / folders."
# Think of it as a "do not pack" list before pushing to GitHub.
# Rules here apply to the entire repo (root + subdirectories),
# unless overridden by a subdirectory's own .gitignore.
# ============================================================


# ============================================================
# DEPENDENCIES
# npm downloads these automatically — never commit them.
# Anyone who clones the repo just runs "npm install" to get them.
# Committing node_modules adds hundreds of MB of files unnecessarily.
# ============================================================
node_modules/
jspm_packages/
.pnp
.pnp.js


# ============================================================
# ENVIRONMENT VARIABLES & SECRETS
# These files contain real API keys, database passwords, and
# JWT secrets. NEVER push them to GitHub — they would be exposed
# to anyone who can see the repository (even private repos can leak).
#
# The .env.example file IS committed — it shows collaborators
# the shape of the .env file without revealing the real values.
# ============================================================
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.staging
.env.staging.local
.env.production
.env.production.local
*.env

# Private keys, certificates, and credentials
*.pem
*.key
*.cert
*.p12
*.pfx
service-account*.json
credentials.json
secrets.json


# ============================================================
# BUILD OUTPUT
# These folders are generated by build tools (Vite, webpack).
# They are re-created from source code on each build — no need
# to track changes to them in Git.
# ============================================================
dist/
build/
out/
.next/
.nuxt/
.output/

# Vite PWA dev dist (generated by vite-plugin-pwa during dev)
dev-dist/


# ============================================================
# LOGS
# Log files are auto-generated by Node.js and other tools.
# They grow indefinitely and differ on every machine, so they
# should never be committed.
# ============================================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*


# ============================================================
# CACHE & TEMPORARY FILES
# Caches speed up builds locally but are machine-specific.
# ============================================================
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
*.tsbuildinfo
tmp/
temp/
.temp/
.tmp/


# ============================================================
# TEST COVERAGE REPORTS
# Generated by Jest, Vitest, or Istanbul — recreatable from
# running tests, so they don't belong in version control.
# ============================================================
coverage/
.nyc_output/


# ============================================================
# UPLOADED FILES (local development only)
# If any route saves uploaded files to disk during development,
# those files should not be committed to the repo.
# In production, all uploads go to Cloudinary.
# ============================================================
uploads/
public/uploads/


# ============================================================
# EDITOR & IDE FILES
# These are personal workspace settings. Different developers
# use different editors, and these files clash between machines.
# Exception: .vscode/extensions.json is useful to share
# (it recommends extensions to new contributors).
# ============================================================
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo


# ============================================================
# OPERATING SYSTEM FILES
# Auto-generated by macOS, Windows, or Linux file managers.
# Completely irrelevant to the project.
# ============================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini


# ============================================================
# DOCUMENTATION (internal/private)
# The docs/ folder is for personal notes and learning material.
# Only README.md (in root) is intended for public documentation.
# ============================================================
docs/


# ============================================================
# AI ASSISTANT FILES
# Internal files generated by AI coding assistants.
# Not part of the project source code.
# ============================================================
.gemini/
.copilot/
.continue/

